BENMA_ENVIRONMENT=development
BENMA_DATABASE_URL=postgresql+psycopg://benma:benma@localhost:5432/benma
BENMA_AUDIO_STORAGE_DIR=./var/audio
BENMA_DEV_AUTH_ENABLED=true
BENMA_SESSION_TTL_DAYS=30
BENMA_MAX_UPLOAD_BYTES=15728640
BENMA_MAX_AUDIO_DURATION_SECONDS=120
BENMA_PERCEPTION_PROVIDER=replay
BENMA_ASSESSMENT_PROVIDER=replay
BENMA_REFERENCE_SPEECH_PROVIDER=replay
BENMA_ACOUSTIC_PROVIDER=autocorrelation
BENMA_ALIGNMENT_PROVIDER=replay
BENMA_CONTEXTUAL_INTERPRETATION_PROVIDER=disabled
BENMA_ASSISTANT_GENERATION_PROVIDER=disabled
BENMA_ASSISTANT_SPEECH_PROVIDER=disabled
BENMA_REFERENCE_SPEECH_VOICE=zh-CN-Xiaochen:DragonHDLatestNeural
BENMA_REFERENCE_SPEECH_MODEL_VERSION=DragonHDLatestNeural
BENMA_REFERENCE_SPEECH_RATE=0%
BENMA_ENABLE_EXPERIMENTAL_TONE_INTERPRETATION=true
BENMA_ENABLE_CATEGORICAL_TONE_JUDGMENT=false
BENMA_OPENAI_API_KEY=
BENMA_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
BENMA_OPENAI_CONTEXTUAL_INTERPRETATION_MODEL=gpt-5.6-terra
BENMA_OPENAI_CONTEXTUAL_INTERPRETATION_REASONING_EFFORT=medium
BENMA_CONTEXTUAL_INTERPRETATION_TIMEOUT_SECONDS=30
BENMA_CONTEXTUAL_INTERPRETATION_VERSION=contextual-decision-v1
BENMA_OPENAI_ASSISTANT_GENERATION_MODEL=gpt-5.6-terra
BENMA_OPENAI_ASSISTANT_GENERATION_REASONING_EFFORT=medium
BENMA_ASSISTANT_GENERATION_TIMEOUT_SECONDS=30
BENMA_ASSISTANT_GENERATION_POLICY_VERSION=free-talk-generation-v1
BENMA_ASSISTANT_SPEECH_VOICE=zh-CN-Xiaochen:DragonHDLatestNeural
BENMA_ASSISTANT_SPEECH_LOCALE=zh-CN
BENMA_ASSISTANT_SPEECH_MODEL_VERSION=DragonHDLatestNeural
BENMA_ASSISTANT_SPEECH_RATE=0%
BENMA_ASSISTANT_SPEECH_TIMEOUT_SECONDS=30
BENMA_AZURE_SPEECH_KEY=
BENMA_AZURE_SPEECH_REGION=
BENMA_TENCENT_SECRET_ID=
BENMA_TENCENT_SECRET_KEY=
BENMA_TENCENT_SOE_APP_ID=
BENMA_TENCENT_SOE_SCORE_COEFF=4.0
BENMA_TENCENT_SOE_TIMEOUT_SECONDS=30
BENMA_IFLYTEK_APP_ID=
BENMA_IFLYTEK_API_KEY=
BENMA_IFLYTEK_API_SECRET=
BENMA_IFLYTEK_ISE_TIMEOUT_SECONDS=45

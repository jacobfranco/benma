        "f0_hz": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "F0 Hz"
        },
        "normalized_semitones": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"

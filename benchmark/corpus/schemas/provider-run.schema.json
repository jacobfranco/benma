    "AcousticAnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "algorithm_version": {
          "title": "Algorithm Version",
          "type": "string"
        },
        "contour_features": {
          "additionalProperties": {
            "anyOf": [

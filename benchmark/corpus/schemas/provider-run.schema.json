      "required": [
        "pitch_algorithm",
        "algorithm_version",
        "sample_rate_hz",
        "f0"
      ],
      "title": "AcousticAnalysisResult",
      "type": "object"
    },
    "AlignmentResult": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "title": "Algorithm",
          "type": "string"
        },
        "algorithm_version": {
          "title": "Algorithm Version",
          "type": "string"
        },
        "confidence_proxy": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"

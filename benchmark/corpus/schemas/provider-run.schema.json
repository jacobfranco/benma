                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Contour Features",
          "type": "object"
        },
        "f0": {
          "items": {
            "$ref": "#/$defs/PitchPoint"
          },
          "title": "F0",
          "type": "array"
        },
        "normalization_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }

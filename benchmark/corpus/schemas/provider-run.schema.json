            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "fluency_score": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }

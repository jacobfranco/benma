          "default": null,
          "title": "Normalization Method"
        },
        "pitch_algorithm": {
          "title": "Pitch Algorithm",
          "type": "string"
        },
        "sample_rate_hz": {
          "exclusiveMinimum": 0,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "voiced_segments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VoicedSegment"
          },
          "title": "Voiced Segments",
          "type": "array"
        }

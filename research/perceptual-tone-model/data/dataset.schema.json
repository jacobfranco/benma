{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Benma canonical perceptual pilot syllable record v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "recording_id": {
      "type": "string",
      "minLength": 1
    },
    "utterance_id": {
      "type": "string",
      "minLength": 1
    },
    "speaker_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "partition": {
      "enum": [
        "stage0",
        "unassigned",
        "train",
        "validation",
        "test"
      ]
    },
    "utterance": {
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reference",
        "sha256",
        "sample_rate_hz",
        "span_id"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "syllable": {
          "type": "string",
          "minLength": 1
        },
        "syllable_index": {
          "type": "integer",
          "minimum": 0
        },
        "syllable_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "unit_kind": {
          "enum": [
            "syllable",
            "timing_group"
          ]
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pinyin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "syllable",
        "syllable_index",
        "syllable_indices",
        "unit_kind",
        "start_seconds",
        "end_seconds",
        "pinyin"
      ]
    },
    "context_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "start_seconds",
        "end_seconds"
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lexical_tone": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            null
          ]
        },
        "surface_tone": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            null
          ]
        },
        "acceptable_families": {
          "type": "array",
          "items": {
            "enum": [
              "TONE_1",
              "TONE_2",
              "TONE_3",
              "TONE_4"
            ]
          },
          "uniqueItems": true
        },
        "surface_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_tone": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            null
          ]
        },
        "next_tone": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            null
          ]
        },
        "neutral_context": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "phrase_position": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_syllable": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_syllable": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lexical_tone",
        "surface_tone",
        "acceptable_families",
        "surface_rule",
        "previous_tone",
        "next_tone",
        "neutral_context",
        "phrase_position",
        "previous_syllable",
        "next_syllable"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "analysis",
            "historical_row"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analysis_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "row_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "path",
        "sha256",
        "analysis_id",
        "row_id"
      ]
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "annotator_id": {
            "type": "string",
            "minLength": 1
          },
          "acceptability": {
            "enum": [
              "acceptable",
              "borderline",
              "incorrect",
              "ungradable"
            ]
          },
          "perceived_tone": {
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4",
              "unclear",
              null
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "judgment_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
          },
          "rubric_version": {
            "const": "1.0"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "origin": {
            "enum": [
              "human",
              "mock_test"
            ]
          }
        },
        "required": [
          "annotator_id",
          "acceptability",
          "perceived_tone",
          "notes",
          "judgment_id",
          "timestamp",
          "rubric_version",
          "version",
          "supersedes",
          "confidence",
          "origin"
        ]
      }
    },
    "deterministic": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/deterministic"
        }
      ]
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "stage0",
            "pilot"
          ]
        },
        "speaker_identity": {
          "enum": [
            "unknown",
            "temporary_fixture",
            "verified"
          ]
        },
        "annotation_kind": {
          "enum": [
            "none",
            "mock_test",
            "human"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "stage",
        "speaker_identity",
        "annotation_kind",
        "notes"
      ]
    },
    "aggregate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "enum": [
                "acceptable",
                "borderline",
                "incorrect",
                "ungradable",
                null
              ]
            },
            "reason": {
              "enum": [
                "unlabeled",
                "high_disagreement",
                "insufficient_judgments",
                "mixed_ungradable",
                "consensus"
              ]
            },
            "counts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "acceptable": {
                  "type": "integer",
                  "minimum": 0
                },
                "borderline": {
                  "type": "integer",
                  "minimum": 0
                },
                "incorrect": {
                  "type": "integer",
                  "minimum": 0
                },
                "ungradable": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "acceptable",
                "borderline",
                "incorrect",
                "ungradable"
              ]
            },
            "n_judgments": {
              "type": "integer",
              "minimum": 0
            },
            "raw_judgment_count": {
              "type": "integer",
              "minimum": 0
            },
            "disagreement_count": {
              "type": "integer",
              "minimum": 0
            },
            "entropy_normalized": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "unanimous": {
              "type": "boolean"
            },
            "config_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "label",
            "reason",
            "counts",
            "n_judgments",
            "raw_judgment_count",
            "disagreement_count",
            "entropy_normalized",
            "unanimous",
            "config_hash"
          ]
        }
      ]
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pcm_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "start_sample": {
              "type": "integer",
              "minimum": 0
            },
            "end_sample": {
              "type": "integer",
              "minimum": 1
            },
            "start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "end_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sample_rate_hz": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "reference",
            "sha256",
            "pcm_sha256",
            "start_sample",
            "end_sample",
            "start_seconds",
            "end_seconds",
            "sample_rate_hz"
          ]
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pcm_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "start_sample": {
              "type": "integer",
              "minimum": 0
            },
            "end_sample": {
              "type": "integer",
              "minimum": 1
            },
            "start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "end_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sample_rate_hz": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "reference",
            "sha256",
            "pcm_sha256",
            "start_sample",
            "end_sample",
            "start_seconds",
            "end_seconds",
            "sample_rate_hz"
          ]
        },
        "wide": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "pcm_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "start_sample": {
              "type": "integer",
              "minimum": 0
            },
            "end_sample": {
              "type": "integer",
              "minimum": 1
            },
            "start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "end_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sample_rate_hz": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "reference",
            "sha256",
            "pcm_sha256",
            "start_sample",
            "end_sample",
            "start_seconds",
            "end_seconds",
            "sample_rate_hz"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "example_id",
    "recording_id",
    "utterance_id",
    "speaker_id",
    "partition",
    "utterance",
    "audio",
    "target",
    "context_window",
    "expected",
    "source",
    "annotations",
    "deterministic",
    "dataset_version",
    "provenance",
    "aggregate",
    "windows"
  ],
  "definitions": {
    "deterministic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_reliability": {
          "enum": [
            "trustworthy",
            "unavailable"
          ]
        },
        "eligibility": {
          "type": [
            "object",
            "null"
          ]
        },
        "structural_reliability": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "observed_family": {
          "enum": [
            "TONE_1",
            "TONE_2",
            "TONE_3",
            "TONE_4",
            "UNCLEAR"
          ]
        },
        "family_decision": {
          "enum": [
            "NUMBERED",
            "UNCLEAR",
            "UNAVAILABLE"
          ]
        },
        "family_scores": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "TONE_1": {
              "type": "number"
            },
            "TONE_2": {
              "type": "number"
            },
            "TONE_3": {
              "type": "number"
            },
            "TONE_4": {
              "type": "number"
            }
          },
          "required": [
            "TONE_1",
            "TONE_2",
            "TONE_3",
            "TONE_4"
          ]
        },
        "winner": {
          "enum": [
            "TONE_1",
            "TONE_2",
            "TONE_3",
            "TONE_4",
            null
          ]
        },
        "winner_support": {
          "type": "number"
        },
        "runner_up": {
          "enum": [
            "TONE_1",
            "TONE_2",
            "TONE_3",
            "TONE_4",
            null
          ]
        },
        "runner_up_support": {
          "type": "number"
        },
        "acceptable_support": {
          "type": "number"
        },
        "margins": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "acoustic": {
              "type": "number"
            },
            "acceptable": {
              "type": "number"
            },
            "runner_up": {
              "type": "number"
            }
          },
          "required": [
            "acoustic",
            "acceptable",
            "runner_up"
          ]
        },
        "clarity": {
          "type": "number"
        },
        "probe_agreement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agreeing": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "fraction": {
              "type": "number"
            },
            "probes": {
              "type": "object"
            }
          },
          "required": [
            "agreeing",
            "total",
            "fraction",
            "probes"
          ]
        },
        "gesture_strength": {
          "enum": [
            "full",
            "weak",
            "unavailable"
          ]
        },
        "learner_grade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agreement": {
              "enum": [
                "STRONG_MATCH",
                "PARTIAL_OR_WEAK",
                "CLEAR_DIFFERENCE",
                "UNAVAILABLE"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "coaching": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "agreement",
            "reason",
            "message",
            "coaching"
          ]
        },
        "color": {
          "enum": [
            "green",
            "amber",
            "red",
            "gray"
          ]
        },
        "coaching_message": {
          "type": [
            "string",
            "null"
          ]
        },
        "chunk": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "grade": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "agreement": {
                      "enum": [
                        "STRONG_MATCH",
                        "PARTIAL_OR_WEAK",
                        "CLEAR_DIFFERENCE",
                        "UNAVAILABLE"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "coaching": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "agreement",
                    "reason",
                    "message",
                    "coaching"
                  ]
                },
                "color": {
                  "enum": [
                    "green",
                    "amber",
                    "red",
                    "gray"
                  ]
                },
                "constituent_role": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "text",
                "grade",
                "color",
                "constituent_role"
              ]
            }
          ]
        },
        "resolved_expectation": {
          "type": "object"
        },
        "shape": {
          "type": "object"
        },
        "acoustic": {
          "type": "object"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "normalized_f0_segments": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "projection": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "baseline_id",
        "evidence_reliability",
        "eligibility",
        "structural_reliability",
        "observed_family",
        "family_decision",
        "family_scores",
        "winner",
        "winner_support",
        "runner_up",
        "runner_up_support",
        "acceptable_support",
        "margins",
        "clarity",
        "probe_agreement",
        "gesture_strength",
        "learner_grade",
        "color",
        "coaching_message",
        "chunk",
        "resolved_expectation",
        "shape",
        "acoustic",
        "duration_seconds",
        "normalized_f0_segments",
        "projection"
      ]
    }
  }
}
